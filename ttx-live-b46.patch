+# -*- coding: utf-8 -*-
+"""Poster teaser bergaya poster film, A4 tegak, dua bahasa.
+
+    python3 teaser_film.py --out ../../dist-poster
+
+Artwork digambar dengan HTML lalu dirender jadi gambar, karena bentuk seperti
+cincin siaga dan tekstur log mustahil disusun rapi lewat kotak PowerPoint.
+Gambar itu lalu dipasang sebagai latar slide, dan hanya tiga keterangan yang
+memang berubah ubah yang berdiri sebagai teks sungguhan di atasnya. Jadi
+tampilannya tetap garang, tapi tanggal, waktu, dan lokasinya tetap diketik
+sendiri tanpa alat apa pun selain PowerPoint.
+
+Latarnya gambar, bukan gradien di dalam PDF. Itu disengaja: gradien CSS
+tersimpan sebagai shading berfungsi PostScript dan sebagian pembaca PDF salah
+menggambarnya.
+"""
+import argparse, base64, pathlib
+
+HERE = pathlib.Path(__file__).parent
+EMBLEM = HERE / "assets" / "maybank-emblem.png"
+
+# A4 pada 300 dpi
+PX_W, PX_H = 2480, 3508
+CSS_W, CSS_H = 794, 1123          # A4 pada 96 dpi
+SCALE = PX_W / CSS_W
+
+ID = {
+    "file": "Teaser-TTX-2026-ID",
+    "stamp": "LATIHAN KESIAPAN INSIDEN SIBER",
+    "labels": ["TANGGAL", "WAKTU", "LOKASI", "LINK ZOOM"],
+    "soon": "COMING SOON",
+    "sub": "LATIHAN TAHUNAN KESIAPAN\nMENGHADAPI INSIDEN SIBER",
+        "title": ["TABLE TOP", "EXERCISE"],
+    "values": ["Isi tanggal di sini", "Isi waktu di sini", "Isi lokasi di sini",
+               "Isi link Zoom di sini"],
+}
+
+EN = {
+    "file": "Teaser-TTX-2026-EN",
+    "stamp": "CYBER INCIDENT READINESS EXERCISE",
+    "labels": ["DATE", "TIME", "LOCATION", "ZOOM LINK"],
+    "soon": "COMING SOON",
+    "sub": "THE ANNUAL CYBER INCIDENT\nREADINESS EXERCISE",
+        "title": ["TABLE TOP", "EXERCISE"],
+    "values": ["Set the date here", "Set the time here", "Set the location here",
+               "Paste the Zoom link here"],
+}
+
+# Letak tabel keterangan, dipakai bersama oleh artwork dan PowerPoint, jadi
+# gambar dan kotak teksnya tidak bisa bergeser sendiri sendiri.
+SIDE_MM = 20.0
+LABEL_W_MM = 34.0
+TABLE_TOP_MM = 191.0
+ROW_H_MM = 18.0
+ROWS = 4
+FOOT_MM = 272.0          # garis penutup di kaki poster
+
+
+def b64(p: pathlib.Path) -> str:
+    return base64.b64encode(p.read_bytes()).decode()
+
+
+def artwork() -> str:
+    """Motif giroskop: tiga cincin orbit dalam perspektif, inti yang menyala,
+    taburan partikel, dan sapuan cahaya.
+
+    Seluruhnya digambar, bukan foto, karena lingkungan pembangun tidak punya
+    sumber gambar. Bentuk orbit dipilih karena abstrak tapi punya kedalaman,
+    jadi terbaca sebagai ilustrasi, bukan sekadar garis hias.
+    """
+    import math, random
+    CX, CY = 560, 395
+    rnd = random.Random(2026)          # tetap, supaya dua bahasa identik
+    out = ['<defs>',
+           '<radialGradient id="bloom" cx="50%" cy="50%" r="50%">',
+           '<stop offset="0%" stop-color="#FFC600" stop-opacity=".30"/>',
+           '<stop offset="45%" stop-color="#FF8A00" stop-opacity=".10"/>',
+           '<stop offset="100%" stop-color="#FFC600" stop-opacity="0"/>',
+           '</radialGradient>',
+           '<radialGradient id="core" cx="50%" cy="50%" r="50%">',
+           '<stop offset="0%" stop-color="#FFF3C4" stop-opacity="1"/>',
+           '<stop offset="35%" stop-color="#FFC600" stop-opacity=".85"/>',
+           '<stop offset="100%" stop-color="#FF8A00" stop-opacity="0"/>',
+           '</radialGradient>',
+           '<linearGradient id="orb" x1="0" y1="0" x2="1" y2="1">',
+           '<stop offset="0%" stop-color="#FFE48A" stop-opacity=".95"/>',
+           '<stop offset="45%" stop-color="#FFC600" stop-opacity=".55"/>',
+           '<stop offset="100%" stop-color="#FFC600" stop-opacity=".06"/>',
+           '</linearGradient>',
+           '<linearGradient id="beam" x1="0" y1="1" x2="1" y2="0">',
+           '<stop offset="0%" stop-color="#FFC600" stop-opacity="0"/>',
+           '<stop offset="50%" stop-color="#FFC600" stop-opacity=".13"/>',
+           '<stop offset="100%" stop-color="#FFC600" stop-opacity="0"/>',
+           '</linearGradient>',
+           '<filter id="soft" x="-60%" y="-60%" width="220%" height="220%">',
+           '<feGaussianBlur stdDeviation="9"/></filter>',
+           '<filter id="soft2" x="-60%" y="-60%" width="220%" height="220%">',
+           '<feGaussianBlur stdDeviation="2.2"/></filter>',
+           '</defs>']
+
+    # sapuan cahaya diagonal di belakang segalanya
+    out.append('<path d="M -140 1123 L 420 -60 L 690 -60 L 130 1123 Z" fill="url(#beam)" '
+               'opacity=".62"/>')
+    out.append('<path d="M 300 1123 L 860 -60 L 980 -60 L 420 1123 Z" fill="url(#beam)" '
+               'opacity=".34"/>')
+
+    # mekar cahaya di belakang giroskop
+    out.append(f'<circle cx="{CX}" cy="{CY}" r="470" fill="url(#bloom)"/>')
+
+    # taburan partikel, lebih rapat di dekat inti
+    for _ in range(190):
+        a = rnd.uniform(0, math.tau)
+        d = rnd.random() ** 0.6 * 520
+        x, y = CX + d * math.cos(a), CY + d * math.sin(a) * 0.92
+        if not (-40 < x < 834 and -40 < y < 1160):
+            continue
+        r = rnd.uniform(0.5, 1.9)
+        o = max(0.05, 0.55 - d / 1000)
+        out.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="{r:.2f}" fill="#FFD966" '
+                   f'fill-opacity="{o:.2f}"/>')
+
+    # tiga cincin orbit dalam perspektif
+    for rx, ry, rot, w, o in ((330, 118, -22, 2.0, .95),
+                              (330, 118, 34, 1.5, .55),
+                              (262, 250, 8, 1.2, .35),
+                              (392, 86, 74, 1.1, .28)):
+        out.append(f'<ellipse cx="{CX}" cy="{CY}" rx="{rx}" ry="{ry}" fill="none" '
+                   f'stroke="url(#orb)" stroke-width="{w}" stroke-opacity="{o}" '
+                   f'transform="rotate({rot} {CX} {CY})" filter="url(#soft2)"/>')
+        out.append(f'<ellipse cx="{CX}" cy="{CY}" rx="{rx}" ry="{ry}" fill="none" '
+                   f'stroke="url(#orb)" stroke-width="{w * .55:.2f}" '
+                   f'stroke-opacity="{min(1, o + .2):.2f}" '
+                   f'transform="rotate({rot} {CX} {CY})"/>')
+
+    # inti
+    out.append(f'<circle cx="{CX}" cy="{CY}" r="150" fill="url(#core)" opacity=".5" '
+               f'filter="url(#soft)"/>')
+    out.append(f'<circle cx="{CX}" cy="{CY}" r="34" fill="url(#core)"/>')
+    out.append(f'<circle cx="{CX}" cy="{CY}" r="9" fill="#FFF8E1"/>')
+
+    # simpul kecil yang duduk di lintasan, memberi kesan bergerak
+    for rx, ry, rot, t in ((330, 118, -22, 0.18), (330, 118, 34, 0.62),
+                           (262, 250, 8, 0.86), (392, 86, 74, 0.40)):
+        a = math.tau * t
+        x0, y0 = rx * math.cos(a), ry * math.sin(a)
+        rr = math.radians(rot)
+        x = CX + x0 * math.cos(rr) - y0 * math.sin(rr)
+        y = CY + x0 * math.sin(rr) + y0 * math.cos(rr)
+        out.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="13" fill="#FFC600" '
+                   f'fill-opacity=".22" filter="url(#soft2)"/>')
+        out.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="3.6" fill="#FFF3C4"/>')
+    return "".join(out)
+
+
+def html(c: dict, *, plate: bool) -> str:
+    """plate=True menghilangkan ketiga nilai, menyisakan tempatnya untuk PowerPoint."""
+    title = "".join(f"<span>{t}</span>" for t in c["title"][:2])
+    rows = ""
+    for i, (lab, val) in enumerate(zip(c["labels"], c["values"])):
+        shown = "" if plate else val
+        top = TABLE_TOP_MM + i * ROW_H_MM
+        cls = "row lnk" if i == 3 else "row"
+        rows += (f'<div class="{cls}" style="top:{top}mm">'
+                 f'<span class="lab">{lab}</span>'
+                 f'<span class="val">{shown}</span></div>'
+                 + (f'<div class="hair" style="top:{top + ROW_H_MM - 4.6}mm"></div>'
+                    if i < len(c["labels"]) - 1 else ""))
+    return f"""<!doctype html><html><head><meta charset="utf-8"><style>
+@page{{size:A4;margin:0}}
+*{{box-sizing:border-box;margin:0;padding:0}}
+html,body{{width:{CSS_W}px;height:{CSS_H - 1}px;overflow:hidden}}
+body{{position:relative;background:#09090B;
+  font-family:Inter,'DejaVu Sans',sans-serif;-webkit-font-smoothing:antialiased}}
+.base{{position:absolute;inset:0;background:
+  linear-gradient(168deg,#141327 0%,#120F1A 26%,#0D0B10 58%,#0A0908 100%)}}
+.warm{{position:absolute;inset:0;background:
+  radial-gradient(ellipse 70% 46% at 66% 36%,rgba(255,138,0,.14) 0%,
+  rgba(255,138,0,0) 70%)}}
+.art{{position:absolute;left:0;top:0;width:100%;height:100%}}
+.vig{{position:absolute;inset:0;background:radial-gradient(ellipse at 66% 36%,
+  rgba(8,7,10,0) 24%,rgba(8,7,10,.42) 58%,rgba(8,7,10,.90) 92%)}}
+/* Lapisan gelap tepat di belakang judul, supaya hurufnya tetap tegas di atas
+   motif yang kini jauh lebih terang. */
+.shade{{position:absolute;left:0;top:64mm;width:78%;height:112mm;
+  background:linear-gradient(90deg,rgba(8,7,10,.92) 0%,rgba(8,7,10,.74) 46%,
+  rgba(8,7,10,0) 100%);
+  -webkit-mask-image:linear-gradient(180deg,rgba(0,0,0,0) 0%,#000 22%,#000 72%,
+  rgba(0,0,0,0) 100%)}}
+.grain{{position:absolute;inset:0;opacity:.05;mix-blend-mode:screen;
+  background-image:url("data:image/svg+xml;utf8,\
+<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'>\
+<filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3'/>\
+</filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
+  background-size:160px 160px}}
+
+.top{{position:absolute;left:{SIDE_MM}mm;right:{SIDE_MM}mm;top:18mm;
+  display:flex;align-items:center;justify-content:space-between}}
+.top .k{{font-size:7.6px;font-weight:800;letter-spacing:.38em;color:#9C9484}}
+.top img{{height:13mm;display:block}}
+.topline{{position:absolute;left:{SIDE_MM}mm;right:{SIDE_MM}mm;top:29mm;height:1px;
+  background:#FFC600;opacity:.28}}
+
+.title{{position:absolute;left:{SIDE_MM}mm;top:97mm;
+  font-family:'Inter Display',Inter,sans-serif;font-weight:900;color:#F7F5EF;
+  line-height:.9;letter-spacing:-.04em;display:flex;flex-direction:column}}
+.title span{{font-size:72px;text-shadow:0 4px 30px rgba(0,0,0,.55)}}
+.year{{position:absolute;left:{SIDE_MM}mm;top:135mm;display:flex;align-items:flex-end;gap:7mm}}
+.year b{{font-family:'Inter Display',Inter,sans-serif;font-weight:900;font-size:72px;
+  line-height:.9;color:#FFC600;letter-spacing:-.04em;
+  text-shadow:0 0 46px rgba(255,198,0,.42)}}
+.year i{{font-style:normal;font-size:8px;font-weight:800;letter-spacing:.34em;
+  color:#B6AE9C;padding-bottom:6mm;max-width:52mm;line-height:2}}
+
+/* Pita keterangan. Latarnya digelapkan sedikit supaya tanggal, waktu, dan
+   lokasi tetap terbaca walau motif di belakangnya ramai. */
+.band{{position:absolute;left:0;right:0;top:{TABLE_TOP_MM - 13}mm;
+  height:{ROWS * ROW_H_MM + 8}mm;
+  background:linear-gradient(90deg,rgba(9,8,11,.88) 0%,rgba(9,8,11,.72) 62%,
+  rgba(9,8,11,.60) 100%)}}
+.tabletop{{position:absolute;left:{SIDE_MM}mm;right:{SIDE_MM}mm;top:{TABLE_TOP_MM - 13}mm;
+  height:2px;background:#FFC600;opacity:.75}}
+.bandbot{{position:absolute;left:{SIDE_MM}mm;right:{SIDE_MM}mm;
+  top:{TABLE_TOP_MM - 13 + ROWS * ROW_H_MM + 8}mm;height:1px;background:#FFC600;opacity:.30}}
+.row{{position:absolute;left:{SIDE_MM}mm;right:{SIDE_MM}mm;display:flex;align-items:baseline}}
+.row .lab{{flex:0 0 {LABEL_W_MM}mm;font-size:8.4px;font-weight:800;letter-spacing:.26em;
+  color:#FFC600;opacity:.9}}
+.row .val{{flex:1;font-family:'Inter Display',Inter,sans-serif;font-size:27px;
+  font-weight:800;color:#FFFFFF;letter-spacing:-.015em;line-height:1}}
+.row.lnk .val{{font-size:14px;font-weight:600;letter-spacing:0;color:#E7E3D9;
+  word-break:break-all}}
+.hair{{position:absolute;left:{SIDE_MM}mm;right:{SIDE_MM}mm;height:1px;
+  background:#FFFFFF;opacity:.12}}
+.footline{{position:absolute;left:{SIDE_MM}mm;right:{SIDE_MM}mm;top:{FOOT_MM}mm;height:1px;
+  background:#FFC600;opacity:.28}}
+.foot{{position:absolute;left:{SIDE_MM}mm;right:{SIDE_MM}mm;top:{FOOT_MM + 5}mm;
+  display:flex;align-items:center;justify-content:space-between;
+  font-size:7.2px;font-weight:800;letter-spacing:.34em;color:#8E8778}}
+.foot em{{font-style:normal;color:#FFC600;opacity:.75}}
+
+/* Penanda jadwal belum diumumkan, dipasang di atas judul. Hurufnya emas dan
+   berjarak lebar supaya terbaca sebagai pengantar, bukan bagian dari judul. */
+.soon{{position:absolute;left:{SIDE_MM}mm;top:80mm;
+  font-family:'Inter Display',Inter,sans-serif;font-size:34px;font-weight:900;
+  letter-spacing:.2em;line-height:1;color:#FFC600;
+  text-shadow:0 0 38px rgba(255,198,0,.40)}}
+</style></head><body>
+<div class="base"></div>
+<div class="warm"></div>
+<svg class="art" viewBox="0 0 {CSS_W} {CSS_H}" preserveAspectRatio="none">{artwork()}</svg>
+<div class="vig"></div>
+<div class="grain"></div>
+<div class="shade"></div>
+
+<div class="top"><span class="k">{c['stamp']}</span>
+  <img src="data:image/png;base64,{b64(EMBLEM)}" alt="Maybank"></div>
+<div class="topline"></div>
+
+<div class="soon">{c['soon']}</div>
+<div class="title">{title}</div>
+<div class="year"><b>2026</b><i>{c['sub'].replace(chr(10), '<br>')}</i></div>
+
+<div class="band"></div>
+<div class="tabletop"></div>
+{rows}
+<div class="bandbot"></div>
+
+<div class="footline"></div>
+<div class="foot"><span>MAYBANK INDONESIA</span><em>TTX 2026</em></div>
+</body></html>"""
+
+
+def shrink(src: pathlib.Path, dst: pathlib.Path, width: int, q: int) -> pathlib.Path:
+    """Perkecil ke lebar tertentu lalu simpan sebagai JPEG.
+
+    Berkas aslinya 300 dpi dan beratnya belasan megabita, terlalu berat untuk
+    di-blast lewat surel atau pesan. 1654 piksel itu setara 200 dpi di kertas
+    A4, masih tajam untuk dicetak kecil maupun dilihat di layar.
+    """
+    from PIL import Image
+    im = Image.open(src).convert("RGB")
+    h = round(im.height * width / im.width)
+    im.resize((width, h), Image.LANCZOS).save(dst, "JPEG", quality=q,
+                                              subsampling=0, optimize=True)
+    return dst
+
+
+def render(c: dict, out: pathlib.Path):
+    from playwright.sync_api import sync_playwright
+    full = out / f"{c['file']}.png"
+    plate = out / f"{c['file']}-plate.png"
+    pdf = out / f"{c['file']}.pdf"
+    with sync_playwright() as p:
+        b = p.chromium.launch()
+        pg = b.new_page(viewport={"width": CSS_W, "height": CSS_H},
+                        device_scale_factor=SCALE)
+        pg.set_content(html(c, plate=False), wait_until="networkidle")
+        pg.wait_for_timeout(200)
+        pg.screenshot(path=str(full))
+        pg.set_content(html(c, plate=True), wait_until="networkidle")
+        pg.wait_for_timeout(200)
+        pg.screenshot(path=str(plate))
+        pg.close(); b.close()
+    # PDF cetak dibuat dari gambar 300 dpi, bukan dari PDF bawaan peramban.
+    # Hasilnya seperlima beratnya, dan gradiennya tersimpan sebagai gambar biasa
+    # sehingga tidak ada lagi shading PostScript yang salah digambar pembaca PDF.
+    from PIL import Image
+    Image.open(full).convert("RGB").save(pdf, "PDF", resolution=300.0, quality=92)
+    jpg = shrink(full, out / f"{c['file']}.jpg", 1654, 88)
+    pjpg = shrink(plate, out / f"{c['file']}-plate.jpg", 1654, 90)
+    plate.unlink()
+    return full, jpg, pjpg, pdf
+
+
+def build_pptx(c: dict, plate: pathlib.Path, out: pathlib.Path):
+    """Artwork jadi latar, tiga keterangan jadi teks sungguhan di atasnya."""
+    from pptx import Presentation
+    from pptx.util import Cm, Pt
+    from pptx.dml.color import RGBColor
+    prs = Presentation()
+    prs.slide_width, prs.slide_height = Cm(21), Cm(29.7)
+    s = prs.slides.add_slide(prs.slide_layouts[6])
+    bg = s.shapes.add_picture(str(plate), 0, 0, width=Cm(21), height=Cm(29.7))
+    bg.name = "Artwork, jangan diubah"
+    names = ["ISI TANGGAL", "ISI WAKTU", "ISI LOKASI", "ISI LINK ZOOM"]
+    x = (SIDE_MM + LABEL_W_MM) / 10
+    for i, val in enumerate(c["values"]):
+        dy = 0.18 if i == 3 else 0.42      # baris link hurufnya lebih kecil
+        t = s.shapes.add_textbox(Cm(x), Cm((TABLE_TOP_MM + i * ROW_H_MM) / 10 - dy),
+                                 Cm(21 - x - SIDE_MM / 10), Cm(1.5))
+        t.name = names[i]
+        f = t.text_frame
+        f.word_wrap = True
+        f.margin_left = f.margin_right = f.margin_top = f.margin_bottom = 0
+        r = f.paragraphs[0].add_run(); r.text = val
+        r.font.name = "Poppins"; r.font.size = Pt(11 if i == 3 else 20)
+        r.font.bold = i != 3
+        r.font.color.rgb = RGBColor(0xF7, 0xF5, 0xEF)
+    path = out / f"{c['file']}.pptx"
+    prs.save(str(path))
+    return path
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", default="out")
+    a = ap.parse_args()
+    out = pathlib.Path(a.out); out.mkdir(parents=True, exist_ok=True)
+    for c in (ID, EN):
+        full, jpg, pjpg, pdf = render(c, out)
+        pptx = build_pptx(c, pjpg, out)
+        pjpg.unlink()
+        mb = lambda f: f.stat().st_size / 1e6
+        print(f"{c['file']}: {jpg.name} {mb(jpg):.1f}MB, {pdf.name} {mb(pdf):.1f}MB, "
+              f"{pptx.name} {mb(pptx):.1f}MB, {full.name} {mb(full):.1f}MB")
+
+
+if __name__ == "__main__":
+    main()
