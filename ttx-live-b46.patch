+def build(c: dict, out: pathlib.Path, url: str):
+    s_ = c["s"]
+    prs = Presentation()
+    prs.slide_width, prs.slide_height = Cm(W), Cm(H)
+    n = 0
+
+    # --- sampul
+    s = blank(prs)
+    box(s, 0, 0, W, H, INK, "Latar sampul", radius=False)
+    box(s, 0, H - 0.8, 6.0, 0.8, YELLOW, "Aksen", radius=False)
+    s.shapes.add_picture(str(LOGO), Cm(M), Cm(1.8), height=Cm(1.9))
+    put(tb(s, M, 5.6, 22, 1.0, "Eyebrow sampul"), "TABLE TOP EXERCISE 2026",
+        size=11, color=YELLOW, font=HEAD, bold=True, spc=2.6)
+    put(tb(s, M, 7.0, 24, 3.2, "Judul sampul"), c["title"], size=46,
+        color=WHITE, font=HEAD, bold=True, line=1.02)
+    put(tb(s, M, 11.4, 22, 1.2, "Subjudul"), c["subtitle"], size=16,
+        color=RGBColor(0xC9, 0xC4, 0xB6), line=1.3)
+    put(tb(s, M, 16.2, 22, 0.8, "Catatan sampul"), c["cover_note"], size=11,
+        color=FAINT)
+    put(tb(s, W - M - 8, 16.2, 8, 0.8, "Alamat"), url.replace("http://", ""),
+        size=11, color=FAINT, font=MONO, align=PP_ALIGN.RIGHT)
+
+    # --- peran
+    n += 1; s = blank(prs)
+    y = chrome(s, n, s_["roles_eye"], s_["roles_t"], s_["roles_l"])
+    cards(s, s_["roles"], y + 0.3, cols=2, height=3.4)
+
+    # --- persiapan
+    n += 1; s = blank(prs)
+    y = chrome(s, n, s_["prep_eye"], s_["prep_t"])
+    steps(s, s_["prep"], y + 0.2)
+
+    # --- excel
+    n += 1; s = blank(prs)
+    y = chrome(s, n, s_["xl_eye"], s_["xl_t"], s_["xl_l"])
+    rows(s, s_["xl"], y + 0.2, label_w=6.0)
+
+    # --- membuka ruangan
+    n += 1; s = blank(prs)
+    y = chrome(s, n, s_["open_eye"], s_["open_t"])
+    steps(s, s_["open"], y + 0.4)
+
+    # --- fase
+    n += 1; s = blank(prs)
+    y = chrome(s, n, s_["phase_eye"], s_["phase_t"])
+    cards(s, s_["phases"], y + 0.4, cols=4, height=4.6)
+    box(s, M, y + 5.6, W - 2 * M, 2.1, SOFT, "Pintasan", line=EDGE)
+    put(tb(s, M + 0.8, y + 6.05, W - 2 * M - 1.6, 1.4, "Teks pintasan"), s_["keys"],
+        size=10, color=DIM, font=MONO, line=1.45)
+
+    # --- saat menjawab
+    n += 1; s = blank(prs)
+    y = chrome(s, n, s_["open2_eye"], s_["open2_t"])
+    cards(s, s_["open2"], y + 0.4, cols=2, height=3.9)
+
+    # --- kapan lanjut
+    n += 1; s = blank(prs)
+    y = chrome(s, n, s_["move_eye"], s_["move_t"], s_["move_l"])
+    rows(s, s_["move"], y + 0.2, label_w=8.0)
+    warn(s, y + 5.4, s_["move_w_s"], s_["move_w"])
+
+    # --- susulan
+    n += 1; s = blank(prs)
+    y = chrome(s, n, s_["late_eye"], s_["late_t"], s_["late_l"])
+    rows(s, s_["late"], y + 0.4, label_w=9.0)
+
+    # --- kunci dan diskusi
+    n += 1; s = blank(prs)
+    y = chrome(s, n, s_["disc_eye"], s_["disc_t"])
+    steps(s, s_["disc"], y + 0.2)
+
+    # --- yang lain
+    n += 1; s = blank(prs)
+    y = chrome(s, n, s_["etc_eye"], s_["etc_t"])
+    cards(s, s_["etc"], y + 0.4, cols=2, height=3.9)
+
+    # --- penanganan
+    n += 1; s = blank(prs)
+    y = chrome(s, n, s_["fix_eye"], s_["fix_t"])
+    rows(s, s_["fix"], y + 0.2, label_w=10.5)
+
+    # --- penutup
+    n += 1; s = blank(prs)
+    box(s, 0, 0, W, H, INK, "Latar penutup", radius=False)
+    box(s, 0, H - 0.8, 6.0, 0.8, YELLOW, "Aksen", radius=False)
+    put(tb(s, M, 7.2, 24, 2.0, "Penutup"), s_["end"], size=36, color=WHITE,
+        font=HEAD, bold=True)
+    put(tb(s, M, 10.2, 20, 2.4, "Catatan penutup"), s_["end_sub"], size=13,
+        color=RGBColor(0xC9, 0xC4, 0xB6), line=1.4)
+    s.shapes.add_picture(str(LOGO), Cm(W - M - 2.4), Cm(H - 4.0), height=Cm(1.8))
+
+    path = out / f"{c['file']}.pptx"
+    prs.save(str(path))
+    return path, n + 1
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", default="out")
+    ap.add_argument("--url", default="http://34.101.211.30")
+    a = ap.parse_args()
+    out = pathlib.Path(a.out); out.mkdir(parents=True, exist_ok=True)
+    for c in (ID, EN):
+        p, total = build(c, out, a.url)
+        print(f"{total} slide -> {p}")
+
+
+if __name__ == "__main__":
+    main()
