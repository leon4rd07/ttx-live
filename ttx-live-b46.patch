+# -*- coding: utf-8 -*-
+"""Salin deck ke bahasa lain tanpa menyentuh tata letak maupun gambarnya.
+
+    python3 translate_deck.py --in deck-en.pptx --out deck-id.pptx
+
+Penggantian dilakukan pada isi penuh satu simpul <a:t>, bukan pada potongan
+kata, supaya kata pendek seperti "Essay" tidak ikut terganti ketika muncul di
+tengah kalimat lain. Setiap teks yang belum punya terjemahan dilaporkan, jadi
+slide tidak pernah diam diam tertinggal separuh berbahasa Inggris.
+"""
+import argparse, pathlib, re, sys, zipfile
+
+sys.path.insert(0, str(pathlib.Path(__file__).parent))
+import deck_id  # noqa: E402
+
+SKIP = re.compile(r'^[\s\d.,×≈%+\-/()\[\]!?:·•]*$')
+TARGET = re.compile(r'(ppt/(slides|diagrams|notesSlides)/[^/]+\.xml)$')
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--in", dest="src", required=True)
+    ap.add_argument("--out", dest="dst", required=True)
+    ap.add_argument("--fix-only", action="store_true",
+                    help="hanya terapkan perbaikan teks Inggris, tanpa menerjemahkan")
+    a = ap.parse_args()
+
+    table = dict(deck_id.EN_FIX)
+    if not a.fix_only:
+        table.update(deck_id.ID)
+        # Perbaikan teks Inggris dirantai ke terjemahannya, kalau tidak hasil
+        # perbaikan itu lolos ke deck Indonesia dalam keadaan masih berbahasa
+        # Inggris, karena penggantian hanya berjalan satu kali.
+        for en, fixed in deck_id.EN_FIX.items():
+            if fixed in deck_id.ID:
+                table[en] = deck_id.ID[fixed]
+
+    missing, used = set(), set()
+
+    def swap(m):
+        txt = m.group(1)
+        if txt in table:
+            used.add(txt)
+            return "<a:t>" + table[txt] + "</a:t>"
+        if txt.strip() and not SKIP.match(txt):
+            missing.add(txt)
+        return m.group(0)
+
+    src = zipfile.ZipFile(a.src)
+    pathlib.Path(a.dst).parent.mkdir(parents=True, exist_ok=True)
+    with zipfile.ZipFile(a.dst, "w", zipfile.ZIP_DEFLATED) as out:
+        for item in src.infolist():
+            data = src.read(item.filename)
+            if TARGET.search(item.filename):
+                txt = data.decode("utf8")
+                txt = re.sub(r"<a:t>([^<]*)</a:t>", swap, txt)
+                data = txt.encode("utf8")
+            out.writestr(item, data)
+    src.close()
+
+    print(f"diterjemahkan: {len(used)} teks")
+    if missing:
+        print(f"\nBELUM ADA TERJEMAHANNYA ({len(missing)}):")
+        for t in sorted(missing):
+            print("   ·", t[:100])
+    chained = set(deck_id.EN_FIX.values()) if not a.fix_only else set()
+    unused = set(table) - used - chained
+    if unused and not a.fix_only:
+        print(f"\ncatatan: {len(unused)} entri tidak terpakai (mungkin teksnya sudah berubah):")
+        for t in sorted(unused):
+            print("   ·", t[:80])
+    print("\ntersimpan ->", a.dst)
+    return 1 if missing else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
