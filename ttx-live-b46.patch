+# -*- coding: utf-8 -*-
+"""Perbarui deck sosialisasi: alamat aplikasi, kode QR, tanggal, dan catatan waktu.
+
+    python3 update_deck.py --in deck.pptx --out deck-baru.pptx --url http://34.101.211.30
+
+Teks diganti langsung di dalam XML, pada isi <a:t> yang memang utuh satu potong,
+supaya seluruh format aslinya tidak tersentuh. Gambar QR diganti dengan ukuran
+piksel yang sama persis supaya tata letak slidenya tidak bergeser.
+"""
+import argparse, io, re, shutil, zipfile, pathlib
+
+
+def new_qr_png(url: str, size: int) -> bytes:
+    import segno
+    from PIL import Image
+    buf = io.BytesIO()
+    segno.make(url, error="m").save(buf, kind="png", scale=10, border=2,
+                                    dark="#101010", light="#FFFFFF")
+    buf.seek(0)
+    im = Image.open(buf).convert("RGB").resize((size, size), Image.NEAREST)
+    out = io.BytesIO()
+    im.save(out, format="PNG")
+    return out.getvalue()
+
+
+def find_qr_media(z: zipfile.ZipFile):
+    """Cari media yang memang berisi QR, bukan menebak dari namanya."""
+    import zxingcpp
+    from PIL import Image
+    found = []
+    for n in z.namelist():
+        if not n.startswith("ppt/media/"):
+            continue
+        try:
+            im = Image.open(io.BytesIO(z.read(n)))
+        except Exception:
+            continue
+        if zxingcpp.read_barcodes(im):
+            found.append((n, im.size))
+    return found
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--in", dest="src", required=True)
+    ap.add_argument("--out", dest="dst", required=True)
+    ap.add_argument("--url", required=True, help="alamat lengkap untuk QR")
+    ap.add_argument("--shown", default=None,
+                    help="alamat yang ditulis di slide; bawaannya url tanpa http://")
+    ap.add_argument("--date", default="[set the briefing date]")
+    a = ap.parse_args()
+    shown = a.shown or a.url.replace("http://", "").replace("https://", "")
+
+    text_subs = {
+        "ttx-live.up.railway.app": shown,
+        "30 October 2026": a.date,
+        # Jendela waktu kini disetel per inject dan bisa berbeda antar unit, jadi
+        # angka tetap di catatan ini sudah tidak selalu benar.
+        "For each inject, 1 minute is given to take in the situation or inject, "
+        "and 5 minutes to discuss and answer the questions.":
+            "For each inject the facilitator sets how long you get to take in the "
+            "situation and how long to answer. Both are shown on your screen.",
+        "Each answering method is given 5 minutes to discuss and answer the question, "
+        "after 1 minute to take in the situation or inject.":
+            "The facilitator sets the answering window for each inject, and different "
+            "units may be given different windows.",
+        "The essay method is given 1 extra minute.":
+            "Essay questions carry a longer window of their own.",
+    }
+
+    src = zipfile.ZipFile(a.src)
+    qr_media = find_qr_media(src)
+    for n, size in qr_media:
+        print(f"QR ditemukan: {n} {size[0]}x{size[1]}")
+
+    counts = {k: 0 for k in text_subs}
+    pathlib.Path(a.dst).parent.mkdir(parents=True, exist_ok=True)
+    with zipfile.ZipFile(a.dst, "w", zipfile.ZIP_DEFLATED) as out:
+        for item in src.infolist():
+            data = src.read(item.filename)
+            qr = next((s for n, s in qr_media if n == item.filename), None)
+            if qr is not None:
+                data = new_qr_png(a.url, qr[0])
+                print(f"  diganti: {item.filename}")
+            elif item.filename.endswith(".xml") and (
+                    "/slides/" in item.filename or "/diagrams/" in item.filename
+                    or "/notesSlides/" in item.filename):
+                txt = data.decode("utf8")
+                for old, new in text_subs.items():
+                    if old in txt:
+                        counts[old] += txt.count(old)
+                        txt = txt.replace(old, new)
+                data = txt.encode("utf8")
+            out.writestr(item, data)
+    src.close()
+
+    print("\npenggantian teks:")
+    for k, v in counts.items():
+        mark = "ok " if v else "TIDAK DITEMUKAN"
+        print(f"  {mark} {v}x  {k[:62]}")
+    print("\ntersimpan ->", a.dst)
+
+
+if __name__ == "__main__":
+    main()
