@@ -0,0 +1,210 @@
+# -*- coding: utf-8 -*-
+"""Bangun poster panduan peserta sebagai PDF A4, dua bahasa.
+
+    python3 poster.py --url http://34.101.211.30 --out ../../dist-poster
+
+Alamatnya dioper lewat argumen, bukan ditanam di kode, karena justru itu yang
+paling sering berubah dan paling mahal kalau salah cetak.
+"""
+import argparse, base64, io, pathlib, sys
+
+sys.path.insert(0, str(pathlib.Path(__file__).parent))
+import content  # noqa: E402
+
+HERE = pathlib.Path(__file__).parent
+LOGO = HERE / "assets" / "maybank-lockup.png"
+
+
+def b64(path: pathlib.Path) -> str:
+    return base64.b64encode(path.read_bytes()).decode()
+
+
+def qr_svg(url: str) -> str:
+    """QR sebagai SVG inline, supaya tetap tajam pada cetakan berapa pun."""
+    import segno
+    buf = io.BytesIO()
+    segno.make(url, error="m").save(buf, kind="svg", scale=1, border=0,
+                                    dark="#101010", svgclass=None, lineclass=None,
+                                    omitsize=True, xmldecl=False, svgns=True)
+    return buf.getvalue().decode("utf8")
+
+
+CSS = """
+@page { size: A4; margin: 0; }
+*{box-sizing:border-box;margin:0;padding:0}
+html,body{width:210mm;height:297mm}
+body{font-family:Inter,'DejaVu Sans',sans-serif;color:#17160F;background:#fff;
+  padding:11mm 12mm 8mm;display:flex;flex-direction:column;
+  font-size:7.4pt;line-height:1.38;-webkit-font-smoothing:antialiased}
+.eyebrow{font-size:6.6pt;font-weight:800;letter-spacing:.18em;color:#8A6200}
+h1{font-size:21pt;font-weight:800;letter-spacing:-.025em;line-height:1.02;margin:2mm 0 1.4mm}
+.lede{color:#4A4740;max-width:104mm;font-size:8pt}
+
+header{display:flex;justify-content:space-between;align-items:flex-start;gap:8mm}
+header img.logo{height:12mm;display:block;margin-bottom:3mm}
+.qrwrap{text-align:center;flex:0 0 auto}
+.qrwrap svg{width:26mm;height:26mm;display:block;shape-rendering:crispEdges}
+.qrcap{font-size:5.6pt;font-weight:800;letter-spacing:.14em;color:#6C6860;margin-top:1.6mm}
+.qrurl{font-family:'DejaVu Sans Mono',monospace;font-size:7pt;font-weight:700;
+  color:#17160F;margin-top:.8mm;word-break:break-all;max-width:34mm}
+
+/* Garis putus putus ini dulu dibuat dengan repeating-linear-gradient. Chromium
+   menyimpannya sebagai shading berfungsi PostScript, dan sebagian pembaca PDF
+   salah menggambarnya sehingga kuningnya berubah merah muda. Sekarang tiap
+   potongnya kotak berisi warna penuh, yang digambar sama di pembaca mana pun. */
+.dash{display:flex;gap:4mm;margin:3mm 0 2.6mm;
+  border-bottom:1.1pt solid #17160F;padding-bottom:2mm}
+.dash i{flex:1;height:2mm;background:#FFC600;display:block;border-radius:.4mm}
+
+.callout{background:#FFC600;border-radius:3mm;padding:2.4mm 3.4mm;display:flex;gap:3mm;
+  align-items:flex-start;margin-bottom:3mm}
+.callout .ic{flex:0 0 7mm;height:7mm;border-radius:2mm;background:#17160F;color:#FFC600;
+  display:flex;align-items:center;justify-content:center;font-size:9pt}
+.callout p{color:#2B2308;font-size:7.6pt}
+.callout b{font-weight:800}
+
+h2{font-size:6.6pt;font-weight:800;letter-spacing:.15em;color:#6C6860;
+  display:flex;align-items:center;gap:3mm;margin-bottom:2.1mm}
+h2::after{content:"";flex:1;height:.6pt;background:#E2DED2}
+
+.flow{display:flex;flex-direction:column;gap:1.5mm;margin-bottom:3mm}
+.step{display:flex;gap:3mm;align-items:flex-start}
+.num{flex:0 0 6.4mm;height:6.4mm;border-radius:1.8mm;background:#17160F;color:#fff;
+  font-weight:800;font-size:7.6pt;display:flex;align-items:center;justify-content:center}
+.stepname{flex:0 0 38mm;font-weight:800;font-size:8pt;padding-top:.7mm}
+.stepbody{flex:1;color:#4A4740;padding-top:.7mm}
+kbd{font-family:'DejaVu Sans Mono',monospace;font-size:6.8pt;background:#F1EEE4;
+  border-radius:1mm;padding:.3mm 1.2mm;font-weight:700}
+
+.qnote{border-left:1.4pt solid #FFC600;padding-left:3mm;margin-bottom:2.1mm;color:#4A4740}
+.qnote b{color:#17160F;font-weight:800}
+.qgrid{display:flex;flex-direction:column;gap:1.2mm;margin-bottom:2.1mm}
+.qrow{display:flex;gap:3mm;align-items:center;background:#FAF8F2;border-radius:2mm;padding:1.7mm 3mm}
+.badge{flex:0 0 7mm;height:7mm;border-radius:2mm;display:flex;align-items:center;
+  justify-content:center;color:#fff;font-size:8pt;font-weight:800}
+.qname{flex:0 0 36mm}
+.qname b{display:block;font-weight:800;font-size:7.8pt}
+.qname span{font-size:6.2pt;color:#8A8578}
+.qdesc{flex:1;color:#4A4740}
+.shapes{display:flex;gap:3mm;align-items:center;background:#EAF6EF;border-radius:2mm;
+  padding:1.7mm 3mm;margin-bottom:3mm;color:#2C5E44}
+.shapes .sh{display:flex;gap:1.6mm;flex:0 0 auto}
+.sh i{width:5.6mm;height:5.6mm;border-radius:1.6mm;display:block}
+
+.cols{display:flex;gap:6mm;flex:1}
+.col{flex:1;min-width:0}
+.strip{background:#FFF7DB;border-radius:2.4mm;padding:2.6mm 3.6mm;color:#5A4406;
+  font-size:7.8pt;line-height:1.5;margin-bottom:3.4mm}
+
+.tlist{display:flex;flex-direction:column;gap:1.8mm}
+.titem{display:flex;gap:2.6mm;align-items:flex-start}
+.dot{flex:0 0 3.4mm;height:3.4mm;border-radius:50%;background:#17160F;margin-top:.9mm}
+.titem b{display:block;font-weight:800;font-size:7.6pt}
+.titem span{color:#4A4740}
+.tick{flex:0 0 3.4mm;height:3.4mm;border-radius:50%;background:#FFC600;color:#17160F;
+  font-size:5.6pt;font-weight:800;display:flex;align-items:center;justify-content:center;
+  margin-top:.9mm}
+
+footer{display:flex;justify-content:space-between;align-items:flex-end;gap:6mm;
+  margin-top:3mm;padding-top:2mm;border-top:.6pt solid #E2DED2}
+.fleft{font-size:6.2pt;font-weight:800;letter-spacing:.12em;color:#8A8578}
+.fright{font-size:5.6pt;color:#A8A294;text-align:right;max-width:72mm;line-height:1.4}
+"""
+
+SHAPE_COLORS = ["#E05A4F", "#3B6FE0", "#8B5CF6", "#2FA36B"]
+BADGE_COLORS = ["#3B6FE0", "#E8B10A", "#8B5CF6"]
+BADGE_GLYPHS = ["★", "✓", "≡"]
+
+
+def build_html(c: dict, url: str) -> str:
+    logo = b64(LOGO)
+    steps = "".join(
+        f'<div class="step"><div class="num">{i+1}</div>'
+        f'<div class="stepname">{n}</div><div class="stepbody">{b}</div></div>'
+        for i, (n, b) in enumerate(c["flow"]))
+    qtypes = "".join(
+        f'<div class="qrow"><div class="badge" style="background:{BADGE_COLORS[i]}">'
+        f'{BADGE_GLYPHS[i]}</div><div class="qname"><b>{n}</b><span>{s}</span></div>'
+        f'<div class="qdesc">{d}</div></div>'
+        for i, (n, s, d) in enumerate(c["qtypes"]))
+    shapes = "".join(f'<i style="background:{col}"></i>' for col in SHAPE_COLORS)
+    trouble = "".join(
+        f'<div class="titem"><div class="dot"></div><div><b>{h}</b><span>{d}</span></div></div>'
+        for h, d in c["trouble"])
+    rules = "".join(
+        f'<div class="titem"><div class="tick">✓</div><div><b>{h}</b><span>{d}</span></div></div>'
+        for h, d in c["rules"])
+    return f"""<!doctype html><html lang="{c['lang']}"><head><meta charset="utf-8">
+<title>{c['title']}</title><style>{CSS}</style></head><body>
+<header>
+  <div>
+    <img class="logo" src="data:image/png;base64,{logo}" alt="Maybank">
+    <div class="eyebrow">{c['eyebrow']}</div>
+    <h1>{c['title']}</h1>
+    <p class="lede">{c['lede']}</p>
+  </div>
+  <div class="qrwrap">{qr_svg(url)}
+    <div class="qrcap">{c['scan']}</div>
+    <div class="qrurl">{url.replace('http://', '')}</div>
+  </div>
+</header>
+<div class="dash">{"<i></i>" * 14}</div>
+<div class="callout"><div class="ic">▣</div>
+  <p><b>{c['callout_strong']}</b> {c['callout']}</p></div>
+
+<h2>{c['flow_head']}</h2>
+<div class="flow">{steps}</div>
+
+<h2>{c['qtype_head']}</h2>
+<div class="qnote"><b>{c['qtype_note_strong']}</b> {c['qtype_note']}</div>
+<div class="qgrid">{qtypes}</div>
+<div class="shapes"><div class="sh">{shapes}</div><div>{c['shapes']}</div></div>
+
+<div class="strip">{c['score_strip']}</div>
+
+<div class="cols">
+  <div class="col">
+    <h2>{c['rule_head']}</h2>
+    <div class="tlist">{rules}</div>
+  </div>
+  <div class="col">
+    <h2>{c['trouble_head']}</h2>
+    <div class="tlist">{trouble}</div>
+  </div>
+</div>
+
+<footer><div class="fleft">{c['footer_left']}</div>
+  <div class="fright">{c['footer_right']}</div></footer>
+</body></html>"""
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--url", required=True, help="alamat aplikasi untuk QR dan teks")
+    ap.add_argument("--out", default="out", help="folder keluaran")
+    a = ap.parse_args()
+    out = pathlib.Path(a.out); out.mkdir(parents=True, exist_ok=True)
+
+    from playwright.sync_api import sync_playwright
+    with sync_playwright() as p:
+        b = p.chromium.launch()
+        for c, name in ((content.ID, "Panduan-Peserta-TTX-Live"),
+                        (content.EN, "Participant-Guide-TTX-App-2026")):
+            html = build_html(c, a.url)
+            (out / f"{name}.html").write_text(html, encoding="utf8")
+            pg = b.new_page()
+            pg.set_content(html, wait_until="networkidle")
+            pg.pdf(path=str(out / f"{name}.pdf"), width="210mm", height="297mm",
+                   print_background=True, margin={"top": "0", "bottom": "0",
+                                                  "left": "0", "right": "0"})
+            # berapa tinggi isinya sebenarnya, untuk memastikan tidak meluber
+            h = pg.evaluate("document.body.scrollHeight")
+            fits = "muat" if h <= 1123 else "MELUBER, akan jadi dua halaman"
+            print(f"{name}: tinggi isi {h}px dari 1123px tersedia -> {fits}")
+            pg.close()
+        b.close()
+    print("selesai ->", out)
+
+
+if __name__ == "__main__":
+    main()
