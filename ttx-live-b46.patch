+# -*- coding: utf-8 -*-
+"""Panduan fasilitator TTX Live, satu deck 16:9, dua bahasa.
+
+    python3 host_guide.py --out ../../dist-poster --url http://34.101.211.30
+
+Dibangun dari kode, bukan disusun tangan, supaya ketika alur aplikasinya berubah
+decknya bisa dibangun ulang tanpa menyusun tata letak dari awal.
+
+Tidak memuat tangkapan layar: lingkungan pembangun tidak bisa menjalankan
+aplikasinya. Slide sengaja diberi ruang kosong di kanan pada beberapa halaman,
+jadi tangkapan layar bisa ditempel belakangan tanpa menggeser apa pun.
+"""
+import argparse, pathlib
+from pptx import Presentation
+from pptx.util import Cm, Pt
+from pptx.dml.color import RGBColor
+from pptx.enum.text import PP_ALIGN
+from pptx.enum.shapes import MSO_SHAPE
+
+HERE = pathlib.Path(__file__).parent
+LOGO = HERE / "assets" / "maybank-lockup.png"
+
+INK = RGBColor(0x17, 0x16, 0x0F)
+YELLOW = RGBColor(0xFF, 0xC6, 0x00)
+WHITE = RGBColor(0xFF, 0xFF, 0xFF)
+DIM = RGBColor(0x4A, 0x47, 0x40)
+FAINT = RGBColor(0x8A, 0x85, 0x78)
+OLIVE = RGBColor(0x8A, 0x62, 0x00)
+SOFT = RGBColor(0xFA, 0xF8, 0xF2)
+EDGE = RGBColor(0xE2, 0xDE, 0xD2)
+WARN = RGBColor(0xA9, 0x6E, 0x06)
+WARNSOFT = RGBColor(0xFC, 0xF0, 0xD8)
+HEAD, BODY, MONO = "Poppins", "Trebuchet MS", "Consolas"
+
+W, H = 33.87, 19.05
+M = 2.2
+
+
+def tb(s, x, y, w, h, name):
+    t = s.shapes.add_textbox(Cm(x), Cm(y), Cm(w), Cm(h))
+    t.name = name
+    f = t.text_frame
+    f.word_wrap = True
+    f.margin_left = f.margin_right = f.margin_top = f.margin_bottom = 0
+    return f
+
+
+def put(f, text, *, size, color, font=BODY, bold=False, line=1.3, spc=0,
+        align=PP_ALIGN.LEFT, first=True):
+    for i, ln in enumerate(text.split("\n")):
+        p = f.paragraphs[0] if (i == 0 and first) else f.add_paragraph()
+        p.alignment = align
+        p.line_spacing = line
+        r = p.add_run(); r.text = ln
+        r.font.name = font; r.font.size = Pt(size); r.font.bold = bold
+        r.font.color.rgb = color
+        if spc:
+            r._r.get_or_add_rPr().set("spc", str(int(spc * 100)))
+    return f
+
+
+def box(s, x, y, w, h, fill, name, line=None, radius=True):
+    sh = s.shapes.add_shape(
+        MSO_SHAPE.ROUNDED_RECTANGLE if radius else MSO_SHAPE.RECTANGLE,
+        Cm(x), Cm(y), Cm(w), Cm(h))
+    sh.name = name
+    sh.fill.solid(); sh.fill.fore_color.rgb = fill
+    if line:
+        sh.line.color.rgb = line; sh.line.width = Pt(0.75)
+    else:
+        sh.line.fill.background()
+    sh.shadow.inherit = False
+    if radius:
+        try:
+            sh.adjustments[0] = 0.06
+        except Exception:
+            pass
+    return sh
+
+
+def blank(prs):
+    return prs.slides.add_slide(prs.slide_layouts[6])
+
+
+def chrome(s, n, eyebrow, title, lede=None):
+    """Kepala halaman yang sama di tiap slide isi."""
+    put(tb(s, M, 1.5, 20, 0.7, "Eyebrow"), eyebrow, size=10, color=OLIVE,
+        font=HEAD, bold=True, spc=2.2)
+    put(tb(s, M, 2.35, 26, 1.5, "Judul"), title, size=27, color=INK,
+        font=HEAD, bold=True, line=1.05)
+    y = 4.3
+    if lede:
+        put(tb(s, M, y, 23.5, 1.8, "Pengantar"), lede, size=12.5, color=DIM, line=1.35)
+        y += 2.3
+    s.shapes.add_picture(str(LOGO), Cm(W - M - 2.0), Cm(1.35), height=Cm(1.5))
+    put(tb(s, W - M - 2.2, 17.6, 2.2, 0.6, "Nomor"), str(n), size=10,
+        color=FAINT, font=MONO, align=PP_ALIGN.RIGHT)
+    return y
+
+
+def cards(s, items, y, cols=None, width=None, height=3.9):
+    cols = cols or len(items)
+    width = width or (W - 2 * M)
+    gap = 0.5
+    cw = (width - gap * (cols - 1)) / cols
+    for i, (head, body) in enumerate(items):
+        col, row = i % cols, i // cols
+        x = M + col * (cw + gap)
+        yy = y + row * (height + gap)
+        box(s, x, yy, cw, height, SOFT, f"Kartu {i+1}", line=EDGE)
+        put(tb(s, x + 0.7, yy + 0.65, cw - 1.4, 1.0, f"Judul kartu {i+1}"),
+            head, size=13, color=INK, font=HEAD, bold=True, line=1.15)
+        put(tb(s, x + 0.7, yy + 1.85, cw - 1.4, height - 2.4, f"Isi kartu {i+1}"),
+            body, size=11, color=DIM, line=1.35)
+
+
+def steps(s, items, y, width=None):
+    width = width or (W - 2 * M)
+    for i, (head, body) in enumerate(items):
+        yy = y + i * 1.75
+        box(s, M, yy, 1.0, 1.0, INK, f"Nomor {i+1}")
+        put(tb(s, M, yy + 0.22, 1.0, 0.7, f"Angka {i+1}"), str(i + 1), size=12.5,
+            color=WHITE, font=HEAD, bold=True, align=PP_ALIGN.CENTER)
+        put(tb(s, M + 1.5, yy + 0.08, 7.6, 0.9, f"Langkah {i+1}"), head,
+            size=13, color=INK, font=HEAD, bold=True)
+        put(tb(s, M + 9.4, yy + 0.08, width - 9.4, 1.5, f"Rincian {i+1}"), body,
+            size=11.5, color=DIM, line=1.35)
+
+
+def rows(s, items, y, width=None, label_w=7.0):
+    width = width or (W - 2 * M)
+    for i, (lab, body) in enumerate(items):
+        yy = y + i * 1.75
+        put(tb(s, M, yy, label_w, 0.9, f"Label {i+1}"), lab, size=12,
+            color=INK, font=HEAD, bold=True)
+        put(tb(s, M + label_w, yy, width - label_w, 1.3, f"Teks {i+1}"), body,
+            size=11.5, color=DIM, line=1.35)
+        if i < len(items) - 1:
+            box(s, M, yy + 1.45, width, 0.03, EDGE, f"Garis {i+1}", radius=False)
+
+
+def warn(s, y, strong, text, width=None):
+    width = width or (W - 2 * M)
+    box(s, M, y, width, 2.0, WARNSOFT, "Kotak peringatan")
+    f = tb(s, M + 0.8, y + 0.5, width - 1.6, 1.2, "Teks peringatan")
+    p = f.paragraphs[0]; p.line_spacing = 1.35
+    r = p.add_run(); r.text = strong + " "
+    r.font.name = HEAD; r.font.size = Pt(12); r.font.bold = True; r.font.color.rgb = WARN
+    r = p.add_run(); r.text = text
+    r.font.name = BODY; r.font.size = Pt(12); r.font.color.rgb = WARN
+
