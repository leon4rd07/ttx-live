# TTX Live — variabel lingkungan untuk VM
#
# Salin berkas ini ke server sebagai /etc/ttx-live/ttx-live.env lalu isi yang
# kosong. JANGAN commit berkas yang sudah terisi ke git: HOST_KEY adalah kata
# sandi, dan .gitignore di repo ini tidak menyaringnya.
#
#   sudo install -d -m 750 /etc/ttx-live
#   sudo cp deploy/ttx-live.env.example /etc/ttx-live/ttx-live.env
#   sudo chmod 640 /etc/ttx-live/ttx-live.env
#   sudo nano /etc/ttx-live/ttx-live.env
#
# Berkas ini dibaca systemd lewat EnvironmentFile=, bukan oleh Node sendiri.
# Proyek ini tidak memakai dotenv, jadi menaruh .env di folder aplikasi tidak
# berpengaruh apa apa.

# ======================================================================
# 1. Dibaca langsung oleh server.js. Hanya tiga ini yang dilihat aplikasi.
# ======================================================================

# Port internal yang didengar Node. Bukan port publik: Apache yang membuka 80,
# lalu meneruskan ke sini. Biarkan 3000 kecuali ada yang memakainya.
PORT=3000

# Kata sandi fasilitator. Wajib diisi di alamat publik. Tanpa ini, siapa pun
# yang menemukan alamatnya bisa membuka ruangan sendiri dan menjalankan
# latihan. Pakai yang panjang dan acak, dan jangan sama dengan kata sandi lain.
HOST_KEY=

# Tempat keadaan ruangan disimpan, supaya latihan tidak hilang kalau proses
# restart di tengah jalan. Foldernya dibuat systemd lewat StateDirectory dan
# dimiliki user service, jadi biarkan apa adanya.
SNAPSHOT_PATH=/var/lib/ttx-live/rooms.json

# ======================================================================
# 2. Lokasi resource dan akses. TIDAK dibaca aplikasi. Dipakai unit systemd,
#    konfigurasi Apache, dan perintah gcloud saat memasang serta memperbarui.
# ======================================================================

# Tempat kode berada di server, dan user yang menjalankannya. User ini sengaja
# tanpa login dan tanpa hak root.
APP_DIR=/opt/ttx-live
APP_USER=ttx
APP_GROUP=ttx

# Letak Node. Periksa dengan: which node
NODE_BIN=/usr/bin/node

# Sumber kode. Memperbarui aplikasi berarti git pull di APP_DIR lalu build.
REPO_URL=https://github.com/leon4rd07/ttx-live.git
REPO_BRANCH=main

# Resource GCP tempat VM ini berada. Isi sesuai punya kolega Anda.
# Zona default di bawah adalah Jakarta; ganti kalau VM-nya di tempat lain.
GCP_PROJECT=
GCP_ZONE=asia-southeast2-a
GCP_INSTANCE=ttx-live

# Alamat publik VM. SERVER_NAME dipakai di vhost Apache. Kalau hanya punya IP,
# isi keduanya dengan IP yang sama. Kalau nanti punya nama host, isi namanya di
# SERVER_NAME supaya HTTPS bisa dipasang.
PUBLIC_IP=
SERVER_NAME=

# Nama aturan firewall GCP yang membuka port 80. Dicatat di sini supaya tidak
# perlu dicari cari saat menutupnya kembali setelah latihan selesai.
GCP_FIREWALL_RULE=ttx-live-allow-http
