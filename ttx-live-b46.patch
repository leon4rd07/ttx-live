@@ -0,0 +1,163 @@
+# -*- coding: utf-8 -*-
+"""Poster teaser sosialisasi, satu slide A4 tegak, dibuat agar mudah disunting.
+
+    python3 teaser.py --out ../../dist-poster
+
+Tanggal, waktu dan lokasi sengaja berdiri sebagai kotak teks terpisah dengan nama
+yang jelas, jadi di PowerPoint tinggal diklik lalu diketik ulang tanpa merusak
+tata letaknya. Fontnya Poppins dan Trebuchet MS, sama seperti deck sosialisasi.
+"""
+import argparse, pathlib
+from pptx import Presentation
+from pptx.util import Cm, Pt, Emu
+from pptx.dml.color import RGBColor
+from pptx.enum.text import PP_ALIGN, MSO_ANCHOR
+
+HERE = pathlib.Path(__file__).parent
+LOGO = HERE / "assets" / "maybank-lockup.png"
+
+INK = RGBColor(0x17, 0x16, 0x0F)
+YELLOW = RGBColor(0xFF, 0xC6, 0x00)
+WHITE = RGBColor(0xFF, 0xFF, 0xFF)
+WARM = RGBColor(0xA8, 0xA2, 0x94)
+DIM = RGBColor(0x4A, 0x47, 0x40)
+HEAD = "Poppins"
+BODY = "Trebuchet MS"
+
+ID = {
+    "file": "Teaser-Sosialisasi-TTX-ID",
+    "eyebrow": "TABLE TOP EXERCISE 2026",
+    "kicker": "SOSIALISASI APLIKASI",
+    "title": "Satu sesi,\nsebelum\nlatihan\ndimulai.",
+    "lede": "Kenali aplikasi yang akan dipakai pada Table Top Exercise, "
+            "supaya hari pelaksanaan tidak habis untuk urusan teknis.",
+    "labels": ["TANGGAL", "WAKTU", "LOKASI"],
+    "values": ["Isi tanggal di sini", "Isi waktu di sini", "Isi lokasi di sini"],
+    "callout_strong": "Bawa laptop atau handphone Anda.",
+    "callout": "Satu perangkat per unit kerja sudah cukup.",
+    "who": "Untuk perwakilan setiap unit kerja",
+    "footer": "Materi ini disusun dengan bantuan AI",
+}
+
+EN = {
+    "file": "Teaser-Sosialisasi-TTX-EN",
+    "eyebrow": "TABLE TOP EXERCISE 2026",
+    "kicker": "APP BRIEFING SESSION",
+    "title": "One session,\nbefore the\nexercise\nbegins.",
+    "lede": "Get to know the app we will use for the Table Top Exercise, so the day "
+            "itself is not spent on technical trouble.",
+    "labels": ["DATE", "TIME", "VENUE"],
+    "values": ["Set the date here", "Set the time here", "Set the venue here"],
+    "callout_strong": "Bring your laptop or phone.",
+    "callout": "One device per business unit is enough.",
+    "who": "For one representative of every business unit",
+    "footer": "Prepared with AI assistance",
+}
+
+
+def box(slide, x, y, w, h, name):
+    tb = slide.shapes.add_textbox(Cm(x), Cm(y), Cm(w), Cm(h))
+    tb.name = name
+    tf = tb.text_frame
+    tf.word_wrap = True
+    tf.margin_left = tf.margin_right = tf.margin_top = tf.margin_bottom = 0
+    return tf
+
+
+def style(tf, text, *, size, color, font=BODY, bold=False, space=0.0, line=None,
+          align=PP_ALIGN.LEFT, caps=False):
+    lines = text.split("\n")
+    for i, ln in enumerate(lines):
+        p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
+        p.alignment = align
+        if line:
+            p.line_spacing = line
+        r = p.add_run()
+        r.text = ln.upper() if caps else ln
+        f = r.font
+        f.name = font
+        f.size = Pt(size)
+        f.bold = bold
+        f.color.rgb = color
+        if space:
+            # jarak antar huruf tidak dibuka python-pptx, jadi disetel di XML
+            r._r.get_or_add_rPr().set("spc", str(int(space * 100)))
+
+
+def rect(slide, x, y, w, h, color, name):
+    from pptx.enum.shapes import MSO_SHAPE
+    sh = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, Cm(x), Cm(y), Cm(w), Cm(h))
+    sh.name = name
+    sh.fill.solid()
+    sh.fill.fore_color.rgb = color
+    sh.line.fill.background()
+    sh.shadow.inherit = False
+    return sh
+
+
+def build(c: dict, out: pathlib.Path):
+    prs = Presentation()
+    prs.slide_width, prs.slide_height = Cm(21), Cm(29.7)
+    s = prs.slides.add_slide(prs.slide_layouts[6])
+
+    # Blok gelap di tengah. Logo tetap berdiri di atas latar putih, karena
+    # wordmark Maybank berwarna gelap dan akan hilang di atas latar gelap.
+    rect(s, 0, 4.6, 21, 13.2, INK, "Blok gelap")
+    rect(s, 0, 17.8, 1.6, 0.55, YELLOW, "Aksen kuning")
+
+    s.shapes.add_picture(str(LOGO), Cm(1.6), Cm(1.5), height=Cm(1.9)).name = "Logo Maybank"
+    tf = box(s, 12.4, 2.25, 7.0, 0.8, "Eyebrow")
+    style(tf, c["eyebrow"], size=8.5, color=WARM, font=HEAD, bold=True,
+          space=1.8, align=PP_ALIGN.RIGHT)
+
+    tf = box(s, 1.6, 5.9, 17.8, 1.0, "Kicker")
+    style(tf, c["kicker"], size=10.5, color=YELLOW, font=HEAD, bold=True, space=2.4)
+
+    tf = box(s, 1.6, 7.1, 17.8, 7.6, "Judul besar")
+    style(tf, c["title"], size=42, color=WHITE, font=HEAD, bold=True, line=1.02)
+
+    tf = box(s, 1.6, 15.0, 15.4, 2.2, "Kalimat pembuka")
+    style(tf, c["lede"], size=12, color=RGBColor(0xC9, 0xC4, 0xB6), line=1.35)
+
+    # Tiga keterangan yang memang untuk diubah ubah.
+    y = 19.4
+    for i, (lab, val) in enumerate(zip(c["labels"], c["values"])):
+        tf = box(s, 1.6, y, 4.6, 0.6, f"Label {lab}")
+        style(tf, lab, size=8.5, color=RGBColor(0x8A, 0x85, 0x78), font=HEAD,
+              bold=True, space=1.8)
+        tf = box(s, 6.6, y - 0.22, 12.8, 1.4, f"ISI {lab}")
+        style(tf, val, size=19, color=INK, font=HEAD, bold=True)
+        if i < 2:
+            rect(s, 1.6, y + 1.5, 17.8, 0.03, RGBColor(0xE2, 0xDE, 0xD2), f"Garis {i+1}")
+        y += 2.1
+
+    rect(s, 1.6, 25.7, 17.8, 1.9, YELLOW, "Kotak kuning")
+    tf = box(s, 2.4, 26.2, 16.2, 1.2, "Teks kotak kuning")
+    p = tf.paragraphs[0]
+    r = p.add_run(); r.text = c["callout_strong"] + " "
+    r.font.name = HEAD; r.font.size = Pt(11.5); r.font.bold = True
+    r.font.color.rgb = RGBColor(0x2B, 0x23, 0x08)
+    r = p.add_run(); r.text = c["callout"]
+    r.font.name = BODY; r.font.size = Pt(11.5); r.font.color.rgb = RGBColor(0x4A, 0x3A, 0x0A)
+
+    tf = box(s, 1.6, 28.1, 12.0, 0.7, "Untuk siapa")
+    style(tf, c["who"], size=9, color=RGBColor(0x6C, 0x68, 0x60))
+    tf = box(s, 13.6, 28.1, 5.8, 0.7, "Catatan kaki")
+    style(tf, c["footer"], size=7.5, color=RGBColor(0xB5, 0xB0, 0xA3), align=PP_ALIGN.RIGHT)
+
+    path = out / f"{c['file']}.pptx"
+    prs.save(str(path))
+    return path
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", default="out")
+    a = ap.parse_args()
+    out = pathlib.Path(a.out); out.mkdir(parents=True, exist_ok=True)
+    for c in (ID, EN):
+        print("tersimpan ->", build(c, out))
+
+
+if __name__ == "__main__":
+    main()
